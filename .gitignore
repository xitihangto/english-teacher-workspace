.DS_Store

# 生成物：交付给用户的成品（docx / pdf / 字体等），一律不入库
/生成物/
/*.docx

# 原料：用户提供的原料、链接抓下来的原文件、OCR 中间文本，不入库
/原料/
/build/wx-*/
/build/*.txt

# 一次性生成脚本：按某份卷写死、含整卷原文，不是通用能力，用完即废。
# 通用渲染层 jiangyi/jy_builder.py、jiangyi/practice_style.py 仍入库。
/build/*.py
/jiangyi/build_*.py

# Python 缓存
__pycache__/
*.pyc

# 工具/py 自建的依赖环境（python-docx + pymupdf），删了下次自动重建
/.venv/
